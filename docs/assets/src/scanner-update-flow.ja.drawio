        <mxCell id="c12" value="スキャナの更新：毎週確認し、検証し、レビューを経て取り込む" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=22;fontColor=#0B1F33;fontFamily=Helvetica;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="22" width="1200" height="30" as="geometry"/></mxCell>
        <mxCell id="c13" value="安全と最新を両立します。ピンは毎週確認し、新しいバージョンはクールダウン、スモークテスト、人のレビューを経て初めて切り替わります。" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#475569;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="58" width="1200" height="20" as="geometry"/></mxCell>
        <mxCell id="c14" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;html=0;whiteSpace=nowrap;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1.5;fontSize=14;fontColor=#0B1F33;fontFamily=Helvetica;verticalAlign=middle;align=center;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="200" height="110" as="geometry"/></mxCell>
        <mxCell id="c15" value="起動" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="119" width="180" height="20" as="geometry"/></mxCell>
        <mxCell id="c16" value="毎週 月曜 02:17 UTC&#10;または手動実行&#10;既定以外のブランチでは&#10;ドライラン（PR なし）" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=12;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="143" width="180" height="68" as="geometry"/></mxCell>
