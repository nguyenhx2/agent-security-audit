        <mxCell id="c21" value="smoke_scanners.py" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#0B1F33;fontFamily=Helvetica;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="119" width="280" height="20" as="geometry"/></mxCell>
        <mxCell id="c22" value="各候補イメージ（8 種）を、&#10;スキャナごとに欠陥を 1 つ&#10;仕込んだフィクスチャで実行し、&#10;今も検出できることを確かめる&#10;読み取り専用のジョブで実行：&#10;書き込みトークンは渡さない" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=12;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="600" y="143" width="280" height="102" as="geometry"/></mxCell>
        <mxCell id="c23" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;html=0;whiteSpace=nowrap;fillColor=#FFFFFF;strokeColor=#3E5C7A;strokeWidth=1.5;fontSize=14;fontColor=#0B1F33;fontFamily=Helvetica;verticalAlign=middle;align=center;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="930" y="110" width="300" height="150" as="geometry"/></mxCell>
