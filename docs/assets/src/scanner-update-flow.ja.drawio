        <mxCell id="c18" value="update_pins.py --check" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#0B1F33;fontFamily=Helvetica;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="280" y="119" width="260" height="20" as="geometry"/></mxCell>
        <mxCell id="c19" value="スキャナごとに最新の安定タグと&#10;マルチアーキのインデックスの&#10;ダイジェストを取得&#10;公開から 7 日待つ（クールダウン）&#10;ダウングレードはしない&#10;exit 10：提案する更新あり" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=12;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="280" y="143" width="260" height="102" as="geometry"/></mxCell>
