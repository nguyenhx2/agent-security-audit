<!-- Source of docs/assets/model-allocation.svg. Export and cleanup: docs/assets/src/README.md -->
<mxfile host="drawio" agent="hand-authored" version="30.0.4">
  <diagram id="model-allocation" name="Model allocation"
           figure-title="Which model does what: allocation per depth and subagent"
           figure-desc="Model allocation per audit depth. Columns Quick, Standard and Deep; rows per role. Recon: lead inline at Quick; recon-mapper subagent Sonnet medium at Standard and Deep. Design lane groups (authz-logic, sensitive-data, ai-agentic): lead inline at Quick, Sonnet high at Standard, Opus high at Deep. Other lane groups (injection-dataflow, mobile, supply-chain-infra, perf-quality): lead inline at Quick, Sonnet medium at Standard, Sonnet high at Deep. Verifier: lead re-checks P0 and P1 at Quick, finding-verifier Sonnet high on P0 and P1 at Standard, Opus high on P0 to P2 at Deep. Translator, only with two or more report languages: report-translator Sonnet medium. Below: the deterministic scripts that do discovery without a model, and the rules every subagent runs under: read-only tools, a turn cap, CLAUDE.md not loaded, and Haiku not used for security judgement.">
    <mxGraphModel dx="1200" dy="772" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1200" pageHeight="772" math="0" shadow="0" background="none">
