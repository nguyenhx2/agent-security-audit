<!-- Source of docs/assets/coverage-map.svg. Export and cleanup: docs/assets/src/README.md -->
<mxfile host="drawio" agent="hand-authored" version="30.0.4">
  <diagram id="coverage-map" name="Coverage map"
           figure-title="What it checks: technical domains and industry sectors"
           figure-desc="Coverage map. Left, seven technical domains with their versioned standards: web and API (OWASP Top 10:2025, ASVS 5.0.0, API Security Top 10 2023, CWE Top 25 2025, IPA How to Secure Your Web Site); mobile (MASVS 2.1.0, MASTG 2.0.0, Mobile Top 10 2024); cloud and IaC (CIS AWS, Azure, GCP, Kubernetes, Docker; OWASP Kubernetes Top 10 2025); CI/CD and supply chain (OWASP CI/CD Top 10, SLSA v1.2, SSDF v1.1, Non-Human Identities Top 10 2025, live advisories); AI, LLM, agents and MCP (LLM Top 10 2026, Agentic Top 10 2026, MCP Top 10 beta, AISVS 1.01) and AI coding-agent configs; sensitive data at rest and payments (PCI DSS v4.0.1); privacy (GDPR, Japan APPI, Vietnam PDPL, CCPA, HIPAA, EU CRA, EU AI Act). Right, six industry sector modules with Japanese, US, EU and Vietnamese rules: medical, finance and crypto assets, e-commerce, public sector, education, and IoT, OT and vehicles. Bottom: nine sector signals detected from code map to six modules, and a sector the user states is added even when the code does not show it.">
    <mxGraphModel dx="1200" dy="861" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1200" pageHeight="861" math="0" shadow="0" background="none">
