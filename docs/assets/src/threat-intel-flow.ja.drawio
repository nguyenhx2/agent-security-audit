        <mxCell id="c49" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;fontSize=12;fontColor=#334155;fontFamily=Helvetica;labelBackgroundColor=#F8FAFC;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c35" target="c38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c50" value="照合の意味は精度で決まります。exact のデプロイ指定は根拠になり、floating タグ（php:8.3-fpm、node:20）は最後にビルドした版、&#10;distro パッケージはバックポートの可能性があるため実環境での確認が必要、managed ランタイムは提供者が更新します。&#10;脆弱性情報は日々変わるため、報告書にはフィードの日付を記し、その日時点の内容として扱います。" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=13;fontColor=#475569;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="600" width="1200" height="80" as="geometry"/></mxCell>
