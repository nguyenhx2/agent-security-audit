<!-- Source of docs/assets/threat-intel-flow.ja.svg. Export and cleanup: docs/assets/src/README.md -->
<mxfile host="drawio" agent="hand-authored" version="30.0.4">
  <diagram id="threat-intel-flow" name="ライブ脅威情報"
           figure-title="ライブ脅威情報：リポジトリがデプロイするものを、当日の脆弱性情報と照合"
           figure-desc="ライブ脅威情報の流れ。監査対象リポジトリのバージョン指定（Dockerfile、compose、Kubernetes と Helm、バージョンファイル、CI のセットアップ手順、サーバーレスのランタイム、フレームワークのロックファイル）を platform_inventory.py がネットワークを使わずに読み、各コンポーネントのバージョン、精度、文脈、露出のシグナルを platform.json に記録する。threat_intel.py はバックグラウンドで、この一覧を海外のフィード（CISA KEV、NVD CVE API 2.0、FIRST EPSS、endoflife.date）と国内のフィード（IPA、JPCERT/CC、JVN、JVN iPedia）に照合し、送信するのは製品名とバージョンだけである。取得に失敗した、または停止中のフィードは報告書に未確認範囲として明記し、合格扱いにはしない。結果の intel.json と intel.md は、コンポーネントを act-now、review、update に分類する。supply-chain-infra レーン（Quick ではリード）が重大度の下限に従って判定し、報告書の第 2 章にプラットフォームのバージョン、勧告 ID、フィードの日付、未取得のフィードを載せる。悪用が確認された CVE がどの指摘にも含まれない場合、検証スクリプトが警告する。">
    <mxGraphModel dx="1260" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1260" pageHeight="700" math="0" shadow="0" background="none">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c11" value="" style="rounded=1;arcSize=18;absoluteArcSize=1;html=0;whiteSpace=nowrap;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1;fontSize=14;fontColor=#0B1F33;fontFamily=Helvetica;verticalAlign=middle;align=center;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1260" height="700" as="geometry"/></mxCell>
        <mxCell id="c12" value="ライブ脅威情報：リポジトリがデプロイするものを、当日の脆弱性情報と照合" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=22;fontColor=#0B1F33;fontFamily=Helvetica;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="22" width="1200" height="30" as="geometry"/></mxCell>
        <mxCell id="c13" value="インシデント名を指定する必要はありません。監査のたびに、見つけたバージョンを国内外の公開フィードと照合します。" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#475569;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="58" width="1200" height="20" as="geometry"/></mxCell>
        <mxCell id="c14" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;html=0;whiteSpace=nowrap;fillColor=#FFFFFF;strokeColor=#3E5C7A;strokeWidth=1.5;fontSize=14;fontColor=#0B1F33;fontFamily=Helvetica;verticalAlign=middle;align=center;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="240" height="170" as="geometry"/></mxCell>
        <mxCell id="c15" value="監査対象リポジトリ" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#0B1F33;fontFamily=Helvetica;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="119" width="220" height="20" as="geometry"/></mxCell>
        <mxCell id="c16" value="Dockerfile の FROM、ARG 既定値&#10;compose、Kubernetes、Helm&#10;.tool-versions、.nvmrc など&#10;CI のセットアップ手順&#10;サーバーレスのランタイム&#10;フレームワークのロックファイル" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=12;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="143" width="220" height="102" as="geometry"/></mxCell>
        <mxCell id="c17" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;html=0;whiteSpace=nowrap;fillColor=#FFFFFF;strokeColor=#3E5C7A;strokeWidth=1.5;fontSize=14;fontColor=#0B1F33;fontFamily=Helvetica;verticalAlign=middle;align=center;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="320" y="110" width="270" height="170" as="geometry"/></mxCell>
        <mxCell id="c18" value="platform_inventory.py" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#0B1F33;fontFamily=Helvetica;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="119" width="250" height="20" as="geometry"/></mxCell>
        <mxCell id="c19" value="ネットワークなし、数秒、platform.json&#10;バージョンと指定箇所の path:line&#10;精度：exact、minor、range、&#10;floating、distro、managed&#10;文脈：deploy、build、ci、dev&#10;露出とハードニングのシグナル" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=12;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="330" y="143" width="250" height="102" as="geometry"/></mxCell>
        <mxCell id="c20" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;html=0;whiteSpace=nowrap;fillColor=#FFFFFF;strokeColor=#16365C;strokeWidth=2.5;fontSize=14;fontColor=#0B1F33;fontFamily=Helvetica;verticalAlign=middle;align=center;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="640" y="110" width="270" height="170" as="geometry"/></mxCell>
        <mxCell id="c21" value="threat_intel.py" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#0B1F33;fontFamily=Helvetica;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="650" y="119" width="250" height="20" as="geometry"/></mxCell>
        <mxCell id="c22" value="バックグラウンド、10-90 秒&#10;送信は製品名とバージョンのみ&#10;接続先は固定の許可リスト&#10;フィードごとに TTL でキャッシュ&#10;フィードの文章は無害化し、&#10;データとして扱う（指示ではない）" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=12;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="650" y="143" width="250" height="102" as="geometry"/></mxCell>
        <mxCell id="c23" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;html=0;whiteSpace=nowrap;fillColor=#FEF3C7;strokeColor=#B45309;strokeWidth=1.5;fontSize=14;fontColor=#0B1F33;fontFamily=Helvetica;verticalAlign=middle;align=center;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="970" y="96" width="260" height="130" as="geometry"/></mxCell>
        <mxCell id="c24" value="海外のフィード" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#78350F;fontFamily=Helvetica;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="980" y="105" width="240" height="20" as="geometry"/></mxCell>
        <mxCell id="c25" value="CISA KEV（悪用、ランサムウェア）&#10;NVD CVE API 2.0（CPE + 版）&#10;FIRST EPSS（30 日の悪用確率）&#10;endoflife.date（サポート期間）" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=12;fontColor=#78350F;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="980" y="129" width="240" height="68" as="geometry"/></mxCell>
        <mxCell id="c26" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;html=0;whiteSpace=nowrap;fillColor=#FEF3C7;strokeColor=#B45309;strokeWidth=1.5;fontSize=14;fontColor=#0B1F33;fontFamily=Helvetica;verticalAlign=middle;align=center;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="970" y="246" width="260" height="130" as="geometry"/></mxCell>
        <mxCell id="c27" value="国内のフィード" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#78350F;fontFamily=Helvetica;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="980" y="255" width="240" height="20" as="geometry"/></mxCell>
        <mxCell id="c28" value="IPA 重要なセキュリティ情報&#10;JPCERT/CC 注意喚起&#10;JVN（JVN#、JVNVU#）&#10;JVN iPedia 新着" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=12;fontColor=#78350F;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="980" y="279" width="240" height="68" as="geometry"/></mxCell>
