        <mxCell id="c30" value="フィードの失敗・停止" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#7F1D1D;fontFamily=Helvetica;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="980" y="449" width="240" height="20" as="geometry"/></mxCell>
        <mxCell id="c31" value="報告書に未確認範囲として&#10;明記し、合格扱いにしない&#10;--offline：キャッシュのみ。&#10;これも明記する" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=12;fontColor=#7F1D1D;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="980" y="473" width="240" height="68" as="geometry"/></mxCell>
