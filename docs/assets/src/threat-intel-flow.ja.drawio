        <mxCell id="c36" value="トリアージ（supply-chain-infra）" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#134E4A;fontFamily=Helvetica;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="449" width="250" height="20" as="geometry"/></mxCell>
        <mxCell id="c37" value="Quick ではリードが担当&#10;重大度の下限：インターネットに&#10;面した exact 指定に KEV = P0/P1&#10;是正策ごとに 1 件：&#10;更新、再ビルド、再デプロイ" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=12;fontColor=#134E4A;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="330" y="473" width="250" height="85" as="geometry"/></mxCell>
