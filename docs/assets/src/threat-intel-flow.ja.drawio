        <mxCell id="c33" value="intel.json + intel.md" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#0B1F33;fontFamily=Helvetica;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="650" y="449" width="250" height="20" as="geometry"/></mxCell>
        <mxCell id="c34" value="act-now：固定版に KEV または&#10;国内注意喚起の CVE&#10;review：EOL、版未確認の注意喚起、重大&#10;update：最新パッチより古い" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=12;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="650" y="473" width="250" height="68" as="geometry"/></mxCell>
