        <mxCell id="c40" value="プラットフォームのバージョンと&#10;脅威情報、勧告 ID、&#10;フィードの日付と未取得分&#10;KEV の CVE が指摘にない&#10;ときは検証で警告" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=12;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="473" width="220" height="85" as="geometry"/></mxCell>
