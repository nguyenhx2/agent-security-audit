<!-- Source of docs/assets/audit-pipeline.svg. Export and cleanup: docs/assets/src/README.md -->
<mxfile host="drawio" agent="hand-authored" version="30.0.4">
  <diagram id="audit-pipeline" name="Audit pipeline"
           figure-title="How an audit runs: scripts discover, models judge, every report is validated"
           figure-desc="The security-audit pipeline as nine phases, each split into what deterministic scripts do and what a model does. Phase 0 Scope: env_check, detect_stack and questions; the lead asks depth, report language, focus and formats. Phase 1 Recon and intel: platform_inventory, threat_intel in the background against public advisory feeds, repo_digest, route_map and agent_config_audit; the recon-mapper subagent (Sonnet, medium) maps the attack surface. Phase 2 Sweep: sensitive_sweep and peek; the data model is read by the lead or the sensitive-data lane. Phase 3 Scanners: run_scanners with eight pinned scanners in the background, then normalize_findings with rule-based auto-refute; no model. Phase 4 Lanes: lane_pack; lane-reviewer subagents in parallel, Sonnet, Opus on design lanes at Deep. Phase 5 Triage and verify: collect_lanes; the finding-verifier tries to refute each candidate. Phase 6 Register: new_finding writes one file per root cause. Phase 7 Report: build_report, validate_findings, render_html, render_xlsx and prune_work; the lead writes the narrative and translator subagents produce other languages. Phase 8, only on request: re-scan with the same scanner digests and close a finding only when it no longer reproduces and the rule still fires. Outputs: findings per language and repo, and Markdown, HTML and Excel reports.">
    <mxGraphModel dx="1560" dy="750" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1560" pageHeight="750" math="0" shadow="0" background="none">
