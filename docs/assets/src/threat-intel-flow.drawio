        <mxCell id="c37" value="the lead at Quick depth&#10;severity floors: KEV on an exact,&#10;internet-facing deploy pin = P0/P1&#10;one finding per remediation:&#10;upgrade, rebuild, redeploy" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=12;fontColor=#134E4A;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="330" y="473" width="250" height="85" as="geometry"/></mxCell>
