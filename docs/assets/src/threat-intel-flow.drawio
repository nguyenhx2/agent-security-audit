        <mxCell id="c34" value="act-now: KEV or national alert&#10;on the pinned version&#10;review: EOL, unmatched alert, critical&#10;update: behind the latest patch" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=12;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="650" y="473" width="250" height="68" as="geometry"/></mxCell>
