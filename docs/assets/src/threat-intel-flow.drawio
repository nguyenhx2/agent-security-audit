        <mxCell id="c48" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;fontSize=12;fontColor=#334155;fontFamily=Helvetica;labelBackgroundColor=#F8FAFC;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c32" target="c35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c49" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;fontSize=12;fontColor=#334155;fontFamily=Helvetica;labelBackgroundColor=#F8FAFC;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c35" target="c38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c50" value="Precision decides what a match means: an exact deploy pin is evidence, a floating tag (php:8.3-fpm, node:20) is whatever was built last,&#10;a distro package may carry a backport and needs a runtime check, a managed runtime is patched by the provider. Advisories change daily,&#10;so the report states the feed date and is true as of that date only." style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=13;fontColor=#475569;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="600" width="1200" height="80" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
