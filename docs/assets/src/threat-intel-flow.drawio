<!-- Source of docs/assets/threat-intel-flow.svg. Export and cleanup: docs/assets/src/README.md -->
<mxfile host="drawio" agent="hand-authored" version="30.0.4">
  <diagram id="threat-intel-flow" name="Live threat intelligence"
           figure-title="Live threat intelligence: what the repo deploys, against today's advisories"
           figure-desc="Flow of the live threat-intelligence step. The audited repos' version pins (Dockerfiles, compose, Kubernetes and Helm, version files, CI setup steps, serverless runtimes, framework lockfile entries) are read by platform_inventory.py with no network; it records each component's version, precision, context and exposure signals in platform.json. threat_intel.py runs in the background and matches that inventory against global feeds (CISA KEV, NVD CVE API 2.0, FIRST EPSS, endoflife.date) and Japanese feeds (IPA, JPCERT/CC, JVN, JVN iPedia), sending only product names and versions. A failed or suspended feed becomes a stated gap in the report, never a pass. The result, intel.json and intel.md, sorts components into act-now, review and update. The supply-chain-infra lane, or the lead at Quick depth, triages it with severity floors, and the report's section 2 lists platform versions, advisory ids, the feed date and feed gaps; the validator warns when a known-exploited CVE is in no finding.">
    <mxGraphModel dx="1260" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1260" pageHeight="700" math="0" shadow="0" background="none">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c11" value="" style="rounded=1;arcSize=18;absoluteArcSize=1;html=0;whiteSpace=nowrap;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1;fontSize=14;fontColor=#0B1F33;fontFamily=Helvetica;verticalAlign=middle;align=center;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1260" height="700" as="geometry"/></mxCell>
        <mxCell id="c12" value="Live threat intelligence: what the repo deploys, against today's advisories" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=22;fontColor=#0B1F33;fontFamily=Helvetica;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="22" width="1200" height="30" as="geometry"/></mxCell>
        <mxCell id="c13" value="No incident has to be named. Every audit matches the versions it finds against public feeds, global and Japanese." style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#475569;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="58" width="1200" height="20" as="geometry"/></mxCell>
        <mxCell id="c14" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;html=0;whiteSpace=nowrap;fillColor=#FFFFFF;strokeColor=#3E5C7A;strokeWidth=1.5;fontSize=14;fontColor=#0B1F33;fontFamily=Helvetica;verticalAlign=middle;align=center;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="240" height="170" as="geometry"/></mxCell>
        <mxCell id="c15" value="The audited repos" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#0B1F33;fontFamily=Helvetica;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="119" width="220" height="20" as="geometry"/></mxCell>
        <mxCell id="c16" value="Dockerfile FROM, ARG defaults&#10;compose, Kubernetes, Helm&#10;.tool-versions, .nvmrc, ...&#10;CI setup steps&#10;serverless runtimes&#10;framework lockfile entries" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=12;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="143" width="220" height="102" as="geometry"/></mxCell>
        <mxCell id="c17" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;html=0;whiteSpace=nowrap;fillColor=#FFFFFF;strokeColor=#3E5C7A;strokeWidth=1.5;fontSize=14;fontColor=#0B1F33;fontFamily=Helvetica;verticalAlign=middle;align=center;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="320" y="110" width="270" height="170" as="geometry"/></mxCell>
        <mxCell id="c18" value="platform_inventory.py" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#0B1F33;fontFamily=Helvetica;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="119" width="250" height="20" as="geometry"/></mxCell>
        <mxCell id="c19" value="no network, seconds, writes platform.json&#10;version with its pin's path:line&#10;precision: exact, minor, range,&#10;floating, distro, managed&#10;context: deploy, build, ci, dev&#10;exposure and hardening signals" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=12;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="330" y="143" width="250" height="102" as="geometry"/></mxCell>
        <mxCell id="c20" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;html=0;whiteSpace=nowrap;fillColor=#FFFFFF;strokeColor=#16365C;strokeWidth=2.5;fontSize=14;fontColor=#0B1F33;fontFamily=Helvetica;verticalAlign=middle;align=center;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="640" y="110" width="270" height="170" as="geometry"/></mxCell>
        <mxCell id="c21" value="threat_intel.py" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#0B1F33;fontFamily=Helvetica;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="650" y="119" width="250" height="20" as="geometry"/></mxCell>
        <mxCell id="c22" value="background, 10-90 s, all repos&#10;sends product + version only&#10;fixed host allowlist&#10;cached with a TTL per feed&#10;feed text sanitised, treated&#10;as data, never instructions" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=12;fontColor=#334155;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="650" y="143" width="250" height="102" as="geometry"/></mxCell>
        <mxCell id="c23" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;html=0;whiteSpace=nowrap;fillColor=#FEF3C7;strokeColor=#B45309;strokeWidth=1.5;fontSize=14;fontColor=#0B1F33;fontFamily=Helvetica;verticalAlign=middle;align=center;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="970" y="96" width="260" height="130" as="geometry"/></mxCell>
        <mxCell id="c24" value="Global feeds" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#78350F;fontFamily=Helvetica;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="980" y="105" width="240" height="20" as="geometry"/></mxCell>
        <mxCell id="c25" value="CISA KEV (exploited, ransomware)&#10;NVD CVE API 2.0 (CPE + version)&#10;FIRST EPSS (30-day likelihood)&#10;endoflife.date (support cycles)" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=12;fontColor=#78350F;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="980" y="129" width="240" height="68" as="geometry"/></mxCell>
        <mxCell id="c26" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;html=0;whiteSpace=nowrap;fillColor=#FEF3C7;strokeColor=#B45309;strokeWidth=1.5;fontSize=14;fontColor=#0B1F33;fontFamily=Helvetica;verticalAlign=middle;align=center;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="970" y="246" width="260" height="130" as="geometry"/></mxCell>
        <mxCell id="c27" value="Japan feeds" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#78350F;fontFamily=Helvetica;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="980" y="255" width="240" height="20" as="geometry"/></mxCell>
        <mxCell id="c28" value="IPA security alerts&#10;JPCERT/CC alerts&#10;JVN (JVN#, JVNVU#)&#10;JVN iPedia new entries" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=12;fontColor=#78350F;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="980" y="279" width="240" height="68" as="geometry"/></mxCell>
        <mxCell id="c29" value="" style="rounded=1;arcSize=10;absoluteArcSize=1;html=0;whiteSpace=nowrap;fillColor=#FEE2E2;strokeColor=#B91C1C;strokeWidth=1.5;fontSize=14;fontColor=#0B1F33;fontFamily=Helvetica;verticalAlign=middle;align=center;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="970" y="440" width="260" height="130" as="geometry"/></mxCell>
        <mxCell id="c30" value="Feed failed or suspended" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=14;fontColor=#7F1D1D;fontFamily=Helvetica;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="980" y="449" width="240" height="20" as="geometry"/></mxCell>
        <mxCell id="c31" value="stated as a coverage gap&#10;in the report, never a pass&#10;--offline: cache only,&#10;also stated" style="text;html=0;whiteSpace=nowrap;align=left;verticalAlign=top;spacing=0;fontSize=12;fontColor=#7F1D1D;fontFamily=Helvetica;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="980" y="473" width="240" height="68" as="geometry"/></mxCell>
