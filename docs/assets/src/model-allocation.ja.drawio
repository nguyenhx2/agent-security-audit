<!-- Source of docs/assets/model-allocation.ja.svg. Export and cleanup: docs/assets/src/README.md -->
<mxfile host="drawio" agent="hand-authored" version="30.0.4">
  <diagram id="model-allocation" name="モデルの割り当て"
           figure-title="どのモデルが何をするか：深さとサブエージェントごとの割り当て"
           figure-desc="監査の深さごとのモデル割り当て。列は Quick、Standard、Deep、行は役割。偵察：Quick はリードがインライン、Standard と Deep は recon-mapper サブエージェント（Sonnet、medium）。設計系レーン（authz-logic、sensitive-data、ai-agentic）：Quick はリード、Standard は Sonnet high、Deep は Opus high。その他のレーン（injection-dataflow、mobile、supply-chain-infra、perf-quality）：Quick はリード、Standard は Sonnet medium、Deep は Sonnet high。検証：Quick はリードが P0 と P1 を再確認、Standard は finding-verifier が Sonnet high で P0 と P1、Deep は Opus high で P0 から P2。翻訳（報告書の言語が 2 つ以上のときのみ）：report-translator、Sonnet medium。下段：モデルを使わずに探索を行う決定論的なスクリプトと、すべてのサブエージェントに適用される規則（読み取り専用のツール、ターン上限、CLAUDE.md を読み込まない、Haiku をセキュリティ判断に使わない）。">
    <mxGraphModel dx="1200" dy="772" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1200" pageHeight="772" math="0" shadow="0" background="none">
